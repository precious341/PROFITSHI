# ==============================================================================
# ProfitShield - Environment Variables Configuration
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# When set, ProfitShield connects to the PostgreSQL database and applies migrations.
# In development/demo preview without an external database, an in-memory/embedded store is used.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/profitshield_db

# Security & Sessions
SESSION_SECRET=super_secret_profitshield_session_key_replace_in_prod_at_least_32_chars
JWT_SECRET=super_secret_jwt_profitshield_token_key_change_me_in_production

# Shopify App Credentials (Obtain from Shopify Partner Dashboard -> Apps -> ProfitShield)
# Note: Never expose these to the browser frontend!
SHOPIFY_API_KEY=shpa_sample_api_key_replace_with_partner_dashboard_key
SHOPIFY_API_SECRET=shpss_sample_api_secret_replace_with_partner_dashboard_secret
SHOPIFY_APP_URL=https://your-profitshield-domain.com
SHOPIFY_API_VERSION=2024-10
SHOPIFY_SCOPES=read_products,read_orders,read_inventory,read_fulfillments,read_price_rules,read_discounts

# Feature Toggles & Operational Flags
DEMO_MODE_ENABLED=true
ENABLE_PROD_MIGRATIONS=false
